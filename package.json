{
  "name": "baidu-panorama-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent Baidu-only street-view metadata workbench",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate_data.mjs",
    "build": "node tools/build_site.mjs",
    "dev": "node tools/build_site.mjs && node tools/serve.mjs",
    "test:browser": "node tools/browser_smoke.mjs --site-root dist/pages",
    "import": "node tools/import_baidu.mjs"
  }
}
